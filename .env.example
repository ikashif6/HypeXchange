# =============================================================================
# HypeXchange environment
# Copy to .env.local for local, and set the same keys in Vercel → Production.
# Never commit real secrets.
# =============================================================================

# MongoDB Atlas (server-only)
# Network Access: allow your IP locally; use 0.0.0.0/0 (or Vercel IPs) in production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hypexchange?retryWrites=true&w=majority&appName=HypeXchange

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Production site (no trailing slash). Locally you may use http://localhost:3000
AUTH_URL=https://hypexchange.space
NEXT_PUBLIC_APP_URL=https://hypexchange.space

# Resend magic-link auth (only provider)
# Domain hypexchange.space must be verified in Resend.
AUTH_RESEND_KEY=re_xxxxxxxx
AUTH_EMAIL_FROM=HypeXchange <noreply@hypexchange.space>

# Absolute logo URL for transactional emails
EMAIL_LOGO_URL=https://hypexchange.space/brand/logo-white-bg.png
